root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:silent

[*.{axaml,csproj,props,targets,json,yml}]
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf

[*.sh]
end_of_line = lf
