<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RatioMaster.ViewModels"
             xmlns:views="using:RatioMaster.Views"
             xmlns:models="using:RatioMaster.Models"
             xmlns:loc="using:RatioMaster.Localization"
             x:Class="RatioMaster.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource DarkAppBgBrush}"
             FontFamily="{DynamicResource UiFontFamily}"
             TopLevel.AutoSafeAreaPadding="False">

  <!-- Desktop and Android share this root. Android scales ScaledContent ×1.25 inside the safe area
       supplied by MobileInsets. AutoSafeAreaPadding is disabled so the insets are applied once. -->
  <Grid Name="RootGrid">
    <Grid Name="ScaledContent" IsEnabled="{Binding !IsShuttingDown}">
    <Grid Name="MainContent" RowDefinitions="Auto,*,Auto">

    <!-- ── Tab strip (tabs + close + add, with Local IP on the same line) ── -->
    <Border Grid.Row="0" Background="{DynamicResource DarkTitleBarBrush}"
            BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="0,0,0,1"
            Padding="8,5,12,0">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Overflow handling: no scrollbar — a ‹ chevron (far left) and a › chevron (far right),
             plus mouse-wheel / touch-swipe. Arrows appear only when the tabs overflow. The + button
             lives INSIDE the scroll, right after the last tab (not pinned to the right edge). -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
          <Button Name="TabLeftBtn" Grid.Column="0" Classes="tabnav" IsVisible="False"
                  Click="OnTabScrollLeft" ToolTip.Tip="{x:Static loc:Strings.ScrollTabsBack}"
                  AutomationProperties.Name="{x:Static loc:Strings.ScrollTabsBack}">
            <Path Width="8" Height="15" Stretch="None" StrokeThickness="1.7"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M 6.5,1 L 1.5,7.5 L 6.5,14"/>
          </Button>
          <ScrollViewer Name="TabScroll" Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="OnTabWheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <ItemsControl Name="TabStrip" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RatioTabViewModel">
                    <Button Classes="tab" Classes.active="{Binding IsActive}"
                            Classes.running="{Binding TabIsRunning}" Classes.paused="{Binding TabIsPaused}" Classes.finished="{Binding TabIsFinished}"
                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectTabCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabName}"
                            ToolTip.Tip="{Binding TorrentFilePath}">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <!-- Dot = this tab's state: grey idle, blue running, green finished, yellow warning, red error —
                             so a tab in trouble is visible from the strip even when it isn't selected. -->
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding DotState, Converter={x:Static views:BoolBrushConverters.TabDot}}"/>
                        <TextBlock Text="{Binding TabName}" VerticalAlignment="Center"/>
                        <Button Classes="tabclose" Content="✕" ToolTip.Tip="{x:Static loc:Strings.CloseTab}"
                                AutomationProperties.Name="{x:Static loc:Strings.CloseTab}"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="tabadd" Content="+" Command="{Binding AddTabCommand}" VerticalAlignment="Bottom"
                      ToolTip.Tip="{x:Static loc:Strings.NewTab}" AutomationProperties.Name="{x:Static loc:Strings.NewTab}"/>
            </StackPanel>
          </ScrollViewer>
          <Button Name="TabRightBtn" Grid.Column="2" Classes="tabnav" IsVisible="False"
                  Click="OnTabScrollRight" ToolTip.Tip="{x:Static loc:Strings.ScrollTabsForward}"
                  AutomationProperties.Name="{x:Static loc:Strings.ScrollTabsForward}">
            <Path Width="8" Height="15" Stretch="None" StrokeThickness="1.7"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M 1.5,1 L 6.5,7.5 L 1.5,14"/>
          </Button>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,0,4">
          <TextBlock Text="{x:Static loc:Strings.LocalIp}" Classes="label" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding LocalIp}" Classes="value" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
          <Button Content="ⓘ" Classes="ghost" Command="{Binding ShowAboutCommand}" ToolTip.Tip="{x:Static loc:Strings.AboutTip}"
                  AutomationProperties.Name="{x:Static loc:Strings.AboutTip}" Padding="6,2" MinWidth="30"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Active tab content ── -->
    <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:RatioTabViewModel">
          <views:RatioTabView/>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- ── Status bar (status text + live stats) ── -->
    <Border Name="StatusBar" Grid.Row="2" MinHeight="34" Background="{DynamicResource DarkTitleBarBrush}"
            BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Name="StatusTextBlock" Grid.Column="0" Text="{Binding SelectedTab.StatusText}" Classes="stat"
                   ToolTip.Tip="{Binding SelectedTab.StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis"/>

        <WrapPanel Name="StatsPanel" Grid.Column="1" Orientation="Horizontal" ItemSpacing="24" LineSpacing="4" HorizontalAlignment="Right">
          <TextBlock Classes="stat"><Run Text="{x:Static loc:Strings.StatRatio}"/><Run Text=" "/><Run Text="{Binding SelectedTab.RatioText}" Foreground="{DynamicResource AccentPrimaryHoverBrush}" FontWeight="SemiBold"/></TextBlock>
          <TextBlock Classes="stat" ToolTip.Tip="{x:Static loc:Strings.StatDoneTip}"><Run Text="{x:Static loc:Strings.StatDone}"/><Run Text=" "/><Run Text="{Binding SelectedTab.ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
          <TextBlock Classes="stat" ToolTip.Tip="{x:Static loc:Strings.StatUploadedTip}"><Run Text="↑ "/><Run Text="{Binding SelectedTab.UploadedText}" Foreground="{DynamicResource StateSuccessBrush}"/></TextBlock>
          <TextBlock Classes="stat" ToolTip.Tip="{x:Static loc:Strings.StatDownloadedTip}"><Run Text="↓ "/><Run Text="{Binding SelectedTab.DownloadedText}" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
          <TextBlock Name="SeedersStatus" Classes="stat"><Run Text="{x:Static loc:Strings.StatSeeders}"/><Run Text=" "/><Run Text="{Binding SelectedTab.SeedersCountText}" Foreground="{DynamicResource StateSuccessBrush}"/></TextBlock>
          <TextBlock Name="LeechersStatus" Classes="stat"><Run Text="{x:Static loc:Strings.StatLeechers}"/><Run Text=" "/><Run Text="{Binding SelectedTab.LeechersCountText}" Foreground="{DynamicResource StateErrorBrush}"/></TextBlock>
          <TextBlock Classes="stat"><Run Text="{x:Static loc:Strings.StatTime}"/><Run Text=" "/><Run Text="{Binding SelectedTab.TotalTimeText}" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
          <TextBlock Classes="stat"><Run Text="{x:Static loc:Strings.StatNext}"/><Run Text=" "/><Run Text="{Binding SelectedTab.TimerText}" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
        </WrapPanel>
      </Grid>
    </Border>

    </Grid>

    <Border Name="AboutOverlay" IsVisible="{Binding AboutOpen}" Background="#B0000000" Padding="12"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource DarkAppBgBrush}" BorderBrush="{DynamicResource DarkBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{x:Static loc:Strings.AboutTitle}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static loc:Strings.LanguageTitle}" Classes="label"/>
              <ComboBox Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static loc:Strings.LanguageTitle}"/>
            </StackPanel>
            <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Content="{x:Static loc:Strings.CheckUpdates}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,6"/>
              <Button Content="{x:Static loc:Strings.Changelog}" Command="{Binding ShowChangelogCommand}" Margin="0,0,8,6"/>
              <Button Content="{x:Static loc:Strings.OpenRelease}" IsVisible="{Binding UpdateAvailable}" Click="OnOpenRelease" Margin="0,0,8,6"/>
              <Button Content="GitHub" Click="OnOpenProject" Margin="0,0,8,6"/>
              <Button Content="{x:Static loc:Strings.ReportBug}" Click="OnReportBug" Margin="0,0,8,6"/>
            </WrapPanel>
            <Button Name="AboutCloseButton" Content="{x:Static loc:Strings.Close}" Command="{Binding CloseAboutCommand}" HorizontalAlignment="Right"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <Border Name="ChangelogOverlay" IsVisible="{Binding ChangelogOpen}" Background="#B0000000" Padding="10"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="780" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="{DynamicResource DarkAppBgBrush}" BorderBrush="{DynamicResource DarkBorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <StackPanel>
            <TextBlock Text="{x:Static loc:Strings.Changelog}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static loc:Strings.ChangelogSubtitle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <!-- The release history is written in English; it keeps its own reading direction. -->
          <ScrollViewer Name="ChangelogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
            <ItemsControl ItemsSource="{Binding ChangelogReleases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ChangelogRelease">
                  <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsLatest, Mode=OneWay}"
                            Margin="0,0,0,10" Padding="0">
                    <Expander.Header>
                      <TextBlock Text="{Binding Version}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryHoverBrush}" TextWrapping="Wrap"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,8,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChangelogItem">
                          <Border Background="{DynamicResource DarkPanelBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel Spacing="5">
                              <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <SelectableTextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" Name="ChangelogBackButton" Content="{x:Static loc:Strings.Back}" Command="{Binding CloseChangelogCommand}"
                  HorizontalAlignment="Right" MinHeight="40" MinWidth="88"/>
        </Grid>
      </Border>
    </Border>

    <Border Name="BatchOverlay" IsVisible="{Binding HasPendingBatch}" Background="#B0000000" Padding="12"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource DarkAppBgBrush}" BorderBrush="{DynamicResource DarkBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Static loc:Strings.BatchTitle}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding BatchQuestion}" TextWrapping="Wrap"/>
          <WrapPanel HorizontalAlignment="Right">
            <Button Name="CancelBatchButton" Content="{x:Static loc:Strings.Cancel}" Command="{Binding CancelBatchCommand}" Margin="0,0,8,6"/>
            <Button Content="{x:Static loc:Strings.BatchAdd}" Command="{Binding ConfirmBatchCommand}" Margin="0,0,0,6"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Name="CloseOverlay" IsVisible="False" Background="#B0000000" Padding="12"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource DarkAppBgBrush}" BorderBrush="{DynamicResource DarkBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{x:Static loc:Strings.ActiveSessionsTitle}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static loc:Strings.ActiveSessionsText}" TextWrapping="Wrap"/>
            <TextBlock Name="TrayUnavailableText" IsVisible="False" Text="{x:Static loc:Strings.TrayUnavailableText}" TextWrapping="Wrap"/>
            <WrapPanel HorizontalAlignment="Right">
              <Button Name="CancelCloseButton" Content="{x:Static loc:Strings.Cancel}" Click="OnCancelClose" Margin="0,0,8,6"/>
              <Button Name="BackgroundCloseButton" Content="{x:Static loc:Strings.MinimizeToTray}" Click="OnBackgroundClose" Margin="0,0,8,6"/>
              <Button Content="{x:Static loc:Strings.QuitAnyway}" Click="OnQuitClose" Margin="0,0,0,6"/>
            </WrapPanel>
            <CheckBox Name="RememberCloseSetting" Content="{x:Static loc:Strings.RememberChoice}" IsChecked="False"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
    </Grid>
  </Grid>
</UserControl>
