<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RatioMaster.ViewModels"
             xmlns:controls="using:RatioMaster.Controls"
             xmlns:behaviors="using:RatioMaster.Behaviors"
             xmlns:views="using:RatioMaster.Views"
             xmlns:loc="using:RatioMaster.Localization"
             x:Class="RatioMaster.Views.RatioTabView"
             x:DataType="vm:RatioTabViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/TerminalScrollBars.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.accent.action.paused">
      <Setter Property="Background" Value="{DynamicResource StateWarningBrush}"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="Button.accent.action.paused /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateWarningBrush}"/>
    </Style>

    <Style Selector="Border.sizewarning.active">
      <Setter Property="Background" Value="Black"/>
    </Style>
    <Style Selector="Border.sizewarning.active TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}"/>
    </Style>
    <!-- Pulsing red frame overlaid on the torrent-file input while it is empty. -->
    <Style Selector="Border.pulseoverlay">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.pulseoverlay.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.0" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.mini">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.num">
      <Setter Property="Width" Value="72"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Translated labels and options can be longer than English: wrap instead of overflowing. -->
    <Style Selector="CheckBox">
      <Setter Property="MaxWidth" Value="420"/>
    </Style>
    <Style Selector="CheckBox /template/ ContentPresenter#ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBox.terminal /template/ ScrollViewer#PART_ScrollViewer /template/ ScrollBar">
      <Setter Property="Theme" Value="{StaticResource TerminalScrollBar}"/>
    </Style>
    <Style Selector="TextBox.terminal /template/ ScrollViewer#PART_ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <!-- The outer terminal border owns the focus outline; its content stays inside that border. -->
    <Style Selector="TextBox.terminal:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.terminal /template/ ScrollViewer#PART_ScrollViewer /template/ Panel#PART_ScrollBarsSeparator">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border#LogBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource DarkBorderFaintBrush}"/>
    </Style>
    <Style Selector="Border#LogBorder.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource DarkAppBgBrush}">
  <Grid Name="PageContent" SizeChanged="OnRootSizeChanged" IsEnabled="{Binding !ManualUpdatePending}">

    <!-- Wide (2-column) layout, in its own vertical ScrollViewer so a short window scrolls instead of
         overflowing (buttons/graph/log). Below the narrow threshold, LeftPanel + RightPanel are reparented
         into NarrowRoot (single scrollable column) by the code-behind — mobile / narrow friendly. -->
    <ScrollViewer Name="WideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <views:WideColumnsPanel Name="WideRoot" VerticalAlignment="Top" Margin="8,7">

    <!-- ═══════════════ LEFT COLUMN ═══════════════ -->
    <Grid Name="LeftPanel" VerticalAlignment="Top" RowDefinitions="Auto">
      <StackPanel Grid.Row="0" Spacing="6">

      <!-- Torrent file -->
      <Border Classes="group">
        <StackPanel Spacing="5">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupTorrentFile}"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Panel Grid.Column="0">
              <!-- Locked while a session runs: editing it would swap the tab's torrent state out from
                   under the engine, which keeps announcing the ORIGINAL info-hash. -->
              <TextBox Text="{Binding TorrentFilePath}" IsEnabled="{Binding InputsEnabled}" FlowDirection="LeftToRight"
                       PlaceholderText="{x:Static loc:Strings.TorrentPathPlaceholder}"
                       AutomationProperties.Name="{x:Static loc:Strings.GroupTorrentFile}"/>
              <Border Classes="pulseoverlay" Classes.pulse="{Binding TorrentInputPulsing}"
                      BorderBrush="{DynamicResource StateErrorBrush}" BorderThickness="1.5"
                      CornerRadius="3" IsHitTestVisible="False"/>
            </Panel>
            <Button Grid.Column="1" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseClick" IsEnabled="{Binding InputsEnabled}"
                    ToolTip.Tip="{x:Static loc:Strings.BrowseTip}" AutomationProperties.Name="{x:Static loc:Strings.Browse}"/>
            <Button Grid.Column="2" Content="{x:Static loc:Strings.AddFolder}" Classes="ghost" Click="OnAddFolderClick"
                    ToolTip.Tip="{x:Static loc:Strings.AddFolderTip}" AutomationProperties.Name="{x:Static loc:Strings.AddFolder}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Torrent info -->
      <Border Classes="group">
        <StackPanel Spacing="4">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupTorrentInfo}"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelTracker}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Tracker}" IsReadOnly="{Binding !InputsEnabled}" FlowDirection="LeftToRight"
                       ToolTip.Tip="{x:Static loc:Strings.TrackerTip}" AutomationProperties.Name="{x:Static loc:Strings.LabelTracker}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelHash}"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding HashHex}" IsReadOnly="True" FontFamily="{DynamicResource MonoFontFamily}"
                       FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static loc:Strings.LabelHash}"/>
            <Border Name="SizeLabel" Grid.Row="2" Grid.Column="0" Classes="sizewarning"
                    Classes.active="{Binding SmallTorrentWarning}" CornerRadius="5" Padding="5,2"
                    VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="{Binding SizeTip}" Tapped="OnSizeTipTapped">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="label" Text="{x:Static loc:Strings.LabelSize}"/>
                <TextBlock Text="⚠" IsVisible="{Binding SmallTorrentWarning}"/>
              </StackPanel>
            </Border>
            <Panel Grid.Row="2" Grid.Column="1">
              <TextBox Name="SizeBox" Text="{Binding TorrentSize}" IsReadOnly="True" AutomationProperties.Name="{x:Static loc:Strings.LabelSize}"
                       ToolTip.Tip="{Binding SizeTip}" Tapped="OnSizeTipTapped" SizeChanged="OnSizeBoxSizeChanged"/>
              <TextBlock Name="SizeHint" Text="{x:Static loc:Strings.SizeHint}" IsVisible="False"
                         Foreground="{DynamicResource StateWarningBrush}" FontSize="11"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,10,0" IsHitTestVisible="False"/>
              <Border Classes="pulseoverlay" Classes.pulse="{Binding SmallTorrentWarning}"
                      BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1.5"
                      CornerRadius="4" IsHitTestVisible="False"/>
            </Panel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Aligned columns for the speed and random controls. -->
      <Border Name="SpeedCard" Classes="group">
        <StackPanel Spacing="6">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupSpeed}"/>
          <!-- Left-aligned Auto columns: label / rate / checkbox line up vertically between the two rows,
               so the upload and download controls sit in the same three columns. -->
          <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10"
                HorizontalAlignment="Left">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelUploadSpeed}" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Text="{Binding UploadSpeed}" behaviors:FieldValidation.Rule="Double"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelUploadSpeed}"/>
            <CheckBox  Grid.Row="0" Grid.Column="2" Content="{x:Static loc:Strings.Random}" IsChecked="{Binding RandomUpload}" VerticalAlignment="Center"
                       ToolTip.Tip="{x:Static loc:Strings.RandomUploadTip}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelDownloadSpeed}" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding DownloadSpeed}" behaviors:FieldValidation.Rule="Double"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelDownloadSpeed}"/>
            <CheckBox  Grid.Row="1" Grid.Column="2" Content="{x:Static loc:Strings.Random}" IsChecked="{Binding RandomDownload}" VerticalAlignment="Center"
                       ToolTip.Tip="{x:Static loc:Strings.RandomDownloadTip}"/>
          </Grid>

        </StackPanel>
      </Border>

      <!-- Options -->
      <Border Classes="group">
        <StackPanel Spacing="6">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupOptions}"/>
          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelInterval}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding IntervalText}" IsEnabled="{Binding InputsEnabled}" behaviors:FieldValidation.Rule="Int"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelInterval}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelFinished}"/>
            <TextBox   Grid.Row="0" Grid.Column="3" Text="{Binding FinishedText}" IsEnabled="{Binding InputsEnabled}" behaviors:FieldValidation.Rule="Double"
                       ToolTip.Tip="{x:Static loc:Strings.FinishedTip}" AutomationProperties.Name="{x:Static loc:Strings.LabelFinished}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelClient}"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ClientFamilies}" AutomationProperties.Name="{x:Static loc:Strings.LabelClient}"
                       SelectedItem="{Binding SelectedFamily}" HorizontalAlignment="Stretch" IsEnabled="{Binding InputsEnabled}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelVersion}"/>
            <ComboBox  Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Versions}" AutomationProperties.Name="{x:Static loc:Strings.LabelVersion}"
                       SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch" IsEnabled="{Binding InputsEnabled}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelStop}"/>
            <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StopWhenOptions}" GotFocus="OnStopInteraction"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelStop}"
                       SelectedItem="{Binding SelectedStopOption}" HorizontalAlignment="Stretch" IsEnabled="{Binding InputsEnabled}"/>
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Panel>
                <TextBox Width="60" Text="{Binding StopValue}" IsVisible="{Binding StopValueVisible}" AutomationProperties.Name="{x:Static loc:Strings.StopValueName}"
                         IsEnabled="{Binding InputsEnabled}" GotFocus="OnStopInteraction" behaviors:FieldValidation.Rule="Double"/>
                <Border Classes="pulseoverlay" Classes.pulse="{Binding StopValuePulsing}"
                        BorderBrush="{DynamicResource StateErrorBrush}" BorderThickness="1.5"
                        CornerRadius="3" IsHitTestVisible="False"/>
              </Panel>
              <TextBlock Classes="mini" Text="{Binding StopUnit}" IsVisible="{Binding StopUnitVisible}" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Custom client simulation -->
      <Border Name="CustomClientCard" Classes="group">
        <StackPanel Spacing="6">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupIdentity}"/>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelKey}"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding CustomKey}" IsEnabled="{Binding InputsEnabled}" FontFamily="{DynamicResource MonoFontFamily}"
                       FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static loc:Strings.LabelKey}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelPort}"/>
            <TextBox   Grid.Row="0" Grid.Column="3" Width="96" Text="{Binding CustomPort}" PlaceholderText="{Binding PortPlaceholder}"
                       IsEnabled="{Binding InputsEnabled}" behaviors:FieldValidation.Rule="Int" FlowDirection="LeftToRight"
                       ToolTip.Tip="{x:Static loc:Strings.PortTip}" AutomationProperties.Name="{x:Static loc:Strings.LabelPort}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelPeerId}"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding CustomPeerId}" IsEnabled="{Binding InputsEnabled}" FontFamily="{DynamicResource MonoFontFamily}"
                       FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static loc:Strings.LabelPeerId}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelPeers}"/>
            <TextBox   Grid.Row="1" Grid.Column="3" Width="96" Text="{Binding CustomPeers}" PlaceholderText="{Binding PeersPlaceholder}"
                       IsEnabled="{Binding InputsEnabled}" behaviors:FieldValidation.Rule="Int" FlowDirection="LeftToRight"
                       ToolTip.Tip="{x:Static loc:Strings.PeersTip}" AutomationProperties.Name="{x:Static loc:Strings.LabelPeers}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <CheckBox Grid.Column="0" VerticalAlignment="Center" Content="{x:Static loc:Strings.RealisticMode}" IsChecked="{Binding RealisticMode}" IsEnabled="{Binding InputsEnabled}"
                      ToolTip.Tip="{x:Static loc:Strings.RealisticModeTip}"/>
            <Button Grid.Column="1" Content="{x:Static loc:Strings.Regenerate}" Classes="ghost" Command="{Binding RegenerateValuesCommand}" IsEnabled="{Binding InputsEnabled}"
                    ToolTip.Tip="{x:Static loc:Strings.RegenerateTip}"/>
          </Grid>
        </StackPanel>
      </Border>

      </StackPanel>

    </Grid>

    <!-- ═══════════════ RIGHT COLUMN ═══════════════ -->
    <Grid Name="RightPanel" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">

      <!-- Other settings -->
      <Border Grid.Row="0" Classes="group">
        <StackPanel Spacing="6">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupOther}"/>
          <!-- WrapPanel so the checkboxes wrap onto new lines when narrow instead of overflowing to the right. -->
          <WrapPanel>
            <CheckBox Content="{x:Static loc:Strings.UseListener}" Margin="0,0,18,4" IsChecked="{Binding UseTcpListener}" IsEnabled="{Binding CanToggleSession}"
                      ToolTip.Tip="{x:Static loc:Strings.UseListenerTip}"/>
            <CheckBox Content="{x:Static loc:Strings.RequestScrape}" Margin="0,0,18,4" IsChecked="{Binding RequestScrape}"
                      ToolTip.Tip="{x:Static loc:Strings.RequestScrapeTip}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Proxy -->
      <Border Grid.Row="1" Classes="group">
        <StackPanel Spacing="6">
          <TextBlock Classes="grouphead" Text="{x:Static loc:Strings.GroupProxy}"/>
          <Grid ColumnDefinitions="Auto,110,Auto,*,Auto,64" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelProxyType}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Name="ProxyTypeBox" ItemsSource="{Binding ProxyTypes}" SelectedItem="{Binding SelectedProxyOption}"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding InputsEnabled}" AutomationProperties.Name="{x:Static loc:Strings.LabelProxyType}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelProxyHost}"/>
            <TextBox Grid.Row="0" Grid.Column="3" Name="ProxyHostBox" Text="{Binding ProxyHost}" IsEnabled="{Binding InputsEnabled}" FlowDirection="LeftToRight"
                     AutomationProperties.Name="{x:Static loc:Strings.LabelProxyHost}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Classes="label" Text="{x:Static loc:Strings.LabelPort}"/>
            <TextBox Grid.Row="0" Grid.Column="5" Name="ProxyPortBox" Text="{Binding ProxyPort}" IsEnabled="{Binding InputsEnabled}" behaviors:FieldValidation.Rule="Int"
                     FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static loc:Strings.ProxyPortName}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="6" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Classes="label" Text="{x:Static loc:Strings.LabelProxyUser}"/>
              <TextBox Grid.Column="1" Name="ProxyUserBox" Text="{Binding ProxyUser}" IsEnabled="{Binding InputsEnabled}" FlowDirection="LeftToRight"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelProxyUser}"/>
              <TextBlock Grid.Column="2" Classes="label" Text="{x:Static loc:Strings.LabelProxyPassword}"/>
              <TextBox Grid.Column="3" Name="ProxyPassBox" Text="{Binding ProxyPass}" PasswordChar="•" IsEnabled="{Binding InputsEnabled}" FlowDirection="LeftToRight"
                       AutomationProperties.Name="{x:Static loc:Strings.LabelProxyPassword}"/>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>

      <!-- The terminal fills the activity space below the fixed graph viewport. -->
      <Border Name="ActivityCard" Grid.Row="2" Classes="group">
        <Grid Name="ActivityGrid" RowDefinitions="Auto,70,*,27">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="grouphead" Text="{x:Static loc:Strings.GroupActivity}" VerticalAlignment="Center" Margin="0"/>
            <CheckBox Grid.Column="1" Content="{x:Static loc:Strings.EnableLog}" IsChecked="{Binding EnableLog}" Margin="14,0,0,0" VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static loc:Strings.EnableLogTip}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Content="{x:Static loc:Strings.Clear}" Classes="ghost" Command="{Binding ClearLogCommand}" ToolTip.Tip="{x:Static loc:Strings.ClearTip}"/>
              <Button Content="{x:Static loc:Strings.Save}" Classes="ghost" Click="OnSaveLogClick" ToolTip.Tip="{x:Static loc:Strings.SaveLogTip}"/>
              <Button Content="⋯" Classes="ghost" Padding="5,0" MinWidth="26" ToolTip.Tip="{x:Static loc:Strings.LogOptions}"
                      AutomationProperties.Name="{x:Static loc:Strings.LogOptions}">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Spacing="8" Width="240">
                      <TextBlock Text="{x:Static loc:Strings.FilterLines}" TextWrapping="Wrap"/>
                      <TextBox Text="{Binding LogFilter}" PlaceholderText="{x:Static loc:Strings.SearchLog}" AutomationProperties.Name="{x:Static loc:Strings.FilterLines}"/>
                      <Button Content="{x:Static loc:Strings.ClearFilter}" Command="{Binding ClearLogFilterCommand}"/>
                      <CheckBox Content="{x:Static loc:Strings.FollowLog}" IsChecked="{Binding FollowLog}"/>
                      <Button Content="{x:Static loc:Strings.CopyLines}" Click="OnCopyLogClick"/>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Fixed graph viewport inside the scrollable page. Time flows left to right in every language. -->
          <Border Name="GraphBorder" Grid.Row="1" MinHeight="64" Background="{DynamicResource LogBgBrush}" BorderBrush="{DynamicResource DarkBorderFaintBrush}"
                  BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
            <Panel ClipToBounds="True">
              <controls:Sparkline Values="{Binding GraphValues}" Margin="1" FlowDirection="LeftToRight"/>
              <TextBlock Classes="mini" Text="{x:Static loc:Strings.UploadRate}" Margin="7,4,7,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            </Panel>
          </Border>

          <!-- The column constrains the terminal viewport independently of the log contents. -->
          <Border Name="LogBorder" Grid.Row="2" MinHeight="118" Background="{DynamicResource LogBgBrush}"
                  BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" ClipToBounds="True" Classes.focused="{Binding #LogBox.IsFocused}">
            <TextBox Name="LogBox" Classes="terminal" Text="{Binding VisibleLogText}" IsReadOnly="True" CaretBrush="Transparent" AcceptsReturn="True"
                     FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static loc:Strings.GroupActivity}"
                     TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.AllowAutoHide="False" ClipToBounds="True"/>
          </Border>

          <!-- Alert line: the CURRENT engine condition (green OK / yellow warning / red error), as opposed
               to the append-only log above. The row is ALWAYS reserved (fixed MinHeight, no IsVisible
               toggle) so a message appearing or clearing can never shift the layout. One line only —
               overflow is ellipsised and the full text is in the tooltip. -->
          <Border Grid.Row="3" MinHeight="22" Margin="0,5,0,0">
            <TextBlock Name="SessionAlert" Text="{Binding AlertMessage}" ToolTip.Tip="{Binding AlertMessage}" FontWeight="SemiBold" FontSize="11.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Foreground="{Binding AlertLevel, Converter={x:Static views:BoolBrushConverters.AlertText}}"/>
          </Border>
        </Grid>
      </Border>

      <!-- Action buttons — 4-across when wide; the code-behind reflows them to 2x2 when narrow. -->
      <Grid Name="ActionBar" Grid.Row="3" ColumnDefinitions="*,*,*,*" RowDefinitions="44" VerticalAlignment="Bottom" ColumnSpacing="6" RowSpacing="6">
        <Panel Grid.Column="0">
          <Button Classes="accent action" Content="{Binding PrimaryActionText}" Classes.paused="{Binding IsPaused}" Command="{Binding StartCommand}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="44" ToolTip.Tip="{x:Static loc:Strings.StartTip}"/>
          <Border Classes="pulseoverlay" Classes.pulse="{Binding StartButtonPulsing}"
                  BorderBrush="{DynamicResource StateErrorBrush}" BorderThickness="2"
                  CornerRadius="4" IsHitTestVisible="False"/>
        </Panel>
        <Button Grid.Column="1" Classes="danger action" Content="{x:Static loc:Strings.ActionStop}" Command="{Binding StopCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="44" ToolTip.Tip="{x:Static loc:Strings.StopTip}"/>
        <Button Grid.Column="2" Classes="action adaptive-label" Command="{Binding ManualUpdateCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="44"
                ToolTip.Tip="{Binding ManualUpdateHint}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{x:Static loc:Strings.ActionManualUpdate}">
          <TextBlock Name="ManualUpdateLabel" Text="{x:Static loc:Strings.ActionManualUpdate}" TextWrapping="NoWrap" TextAlignment="Center" VerticalAlignment="Center" SizeChanged="OnActionLabelSizeChanged"/>
        </Button>
        <Button Grid.Column="3" Classes="action adaptive-label" Command="{Binding SetDefaultsCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="44"
                ToolTip.Tip="{x:Static loc:Strings.SetDefaultsTip}" AutomationProperties.Name="{x:Static loc:Strings.ActionSetDefaults}">
          <TextBlock Name="DefaultsLabel" Text="{x:Static loc:Strings.ActionSetDefaults}" TextWrapping="NoWrap" TextAlignment="Center" VerticalAlignment="Center" SizeChanged="OnActionLabelSizeChanged"/>
        </Button>
      </Grid>
    </Grid>
    </views:WideColumnsPanel>
    </ScrollViewer>

    <!-- Narrow (single-column, scrollable) layout — LeftPanel + RightPanel are moved in here in code. -->
    <ScrollViewer Name="NarrowRoot" IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="NarrowStack" Spacing="8" Margin="8,7"/>
    </ScrollViewer>
  </Grid>
    <!-- Shared modal layer: supported by both desktop and Android's single-view lifetime. -->
    <Border Name="ManualUpdateOverlay" IsVisible="{Binding ManualUpdatePending}" Background="#B0000000" Padding="12">
      <Border MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource DarkAppBgBrush}" BorderBrush="{DynamicResource DarkBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{x:Static loc:Strings.ManualConfirmTitle}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static loc:Strings.ManualConfirmWarning}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static loc:Strings.ManualConfirmAdvice}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Static loc:Strings.ManualConfirmNext}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding NextUpdateCountdown}" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                       FontFamily="{DynamicResource MonoFontFamily}"/>
            <WrapPanel HorizontalAlignment="Right">
              <Button Name="CancelUpdateButton" Content="{x:Static loc:Strings.KeepWaiting}" Command="{Binding CancelManualUpdateCommand}" Margin="0,0,8,6"
                      ToolTip.Tip="{x:Static loc:Strings.KeepWaitingTip}"/>
              <Button Content="{x:Static loc:Strings.UpdateNow}" Command="{Binding ConfirmManualUpdateCommand}" Margin="0,0,0,6"
                      ToolTip.Tip="{x:Static loc:Strings.UpdateNowTip}"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
